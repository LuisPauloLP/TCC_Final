<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/cardDocumento"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="6dp"

    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"

    app:strokeWidth="1dp"
    app:strokeColor="#BDBDBD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="10dp">


        <!-- Primeira linha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtNomeDocumento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Conta de Luz"
                android:textStyle="bold"
                android:textSize="16sp"/>


            <TextView
                android:id="@+id/txtSelecionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="✓"
                android:textSize="24sp"
                android:visibility="gone"/>

        </LinearLayout>


        <!-- Segunda linha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtVencimento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Venc: --"/>


            <TextView
                android:id="@+id/txtBeneficiario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Beneficiário"/>

        </LinearLayout>


        <!-- Valor -->
        <TextView
            android:id="@+id/txtValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="end"
            android:text="R$ --"
            android:textStyle="bold"/>


        <!-- Botões de um único documento -->
        <LinearLayout
            android:id="@+id/layoutAcoesDocumento"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingTop="6dp">


            <Button
                android:id="@+id/btnAbrirDocumento"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Abrir"
                android:textAllCaps="false"/>


            <Button
                android:id="@+id/btnDeletarDocumento"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Deletar"
                android:textAllCaps="false"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>