<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9F7"
    android:padding="16dp">


    <!-- ============================== -->
    <!-- TÍTULO -->
    <!-- ============================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meus documentos"
        android:textColor="#1B5E20"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />


    <!-- ============================== -->
    <!-- PESQUISA -->
    <!-- ============================== -->

    <EditText
        android:id="@+id/edtPesquisar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_pesquisa"
        android:hint="Pesquisar documentos..."
        android:singleLine="true"
        android:textColor="#263238"
        android:textColorHint="#78909C"
        android:textSize="16sp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp" />


    <!-- ============================== -->
    <!-- BOTÃO FILTROS -->
    <!-- ============================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFiltros"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Filtros ▼"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2E7D32"
        app:cornerRadius="12dp" />


    <!-- ============================== -->
    <!-- GAVETA DE FILTROS -->
    <!-- ============================== -->

    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_gaveta_filtros"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesquisar em:"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />


        <!-- PRIMEIRA LINHA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnFiltroVencimento"
                android:layout_width="20dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_filtro"
                android:text="Vencimento"
                android:textAllCaps="false"
                android:textColor="@color/texto_filtro"
                android:textSize="12sp"
                android:stateListAnimator="@null" />


            <Button
                android:id="@+id/btnFiltroNome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_filtro"
                android:text="Nome"
                android:textAllCaps="false"
                android:textColor="@color/texto_filtro"
                android:textSize="12sp"
                android:stateListAnimator="@null" />


            <Button
                android:id="@+id/btnFiltroValor"
                android:layout_width="10dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_filtro"
                android:text="Valor Total"
                android:textAllCaps="false"
                android:textColor="@color/texto_filtro"
                android:textSize="12sp"
                android:stateListAnimator="@null" />

        </LinearLayout>


        <!-- SEGUNDA LINHA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnFiltroLinhaDigitavel"
                android:layout_width="165dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_filtro"
                android:text="Núm. Digitável"
                android:textAllCaps="false"
                android:textColor="@color/texto_filtro"
                android:textSize="12sp"
                android:stateListAnimator="@null" />


            <Button
                android:id="@+id/btnFiltroBeneficiario"
                android:layout_width="165dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_filtro"
                android:text="Beneficiário"
                android:textAllCaps="false"
                android:textColor="@color/texto_filtro"
                android:textSize="12sp"
                android:stateListAnimator="@null"
                />


            <!-- Espaço para manter largura igual -->
            <Space
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp" />

        </LinearLayout>


        <!-- SELECIONAR / DESMARCAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelecionarTodosFiltros"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Selecionar todos"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#388E3C"
                app:cornerRadius="10dp" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLimparFiltros"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Desmarcar todos"
                android:textAllCaps="false"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:strokeColor="#2E7D32"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ============================== -->
    <!-- LISTA -->
    <!-- ============================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDocumentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="8dp" />


    <!-- ============================== -->
    <!-- SELEÇÃO MÚLTIPLA -->
    <!-- ============================== -->

    <LinearLayout
        android:id="@+id/layoutAcoesMultiplas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:gravity="center"
        android:visibility="gone">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarDocumentos"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Enviar documentos"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            app:cornerRadius="12dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletarSelecionados"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Deletar"
            android:textAllCaps="false"
            android:textColor="#B71C1C"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            app:cornerRadius="12dp"
            app:strokeColor="#C62828"
            app:strokeWidth="1dp" />

    </LinearLayout>

</LinearLayout>