<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header: Logo e Nome -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:src="@drawable/logo4"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Botões Superiores Direitos (Info e Notas) -->
    <Button
        android:id="@+id/btnInfo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_background"
        android:text="i"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="@null"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnNotas"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/black"
        android:background="@drawable/circle_background"
        app:backgroundTint="@null"
        android:text="n"
        android:textSize="18sp"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnInfo" />

    <!-- Textos Centrais -->
    <TextView
        android:id="@+id/txtBemVindo"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="Olá, seja bem-vindo!"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo" />

    <TextView
        android:id="@+id/txtInstrucao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:textColor="@color/black"
        android:text="Aperte a opção desejada"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtBemVindo" />

    <!-- Botões Principais -->
    <Button
        android:id="@+id/btnDigitalizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp"
        android:textSize="20dp"
        android:textColor="@color/white"
        android:background="@drawable/button_menu"
        android:text="Digitalizar novo arquivo"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@+id/txtInstrucao" />

    <Button
        android:id="@+id/btnInserir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp"
        android:textSize="20dp"
        android:textColor="@color/white"
        android:background="@drawable/button_menu"
        app:backgroundTint="@null"
        android:text="Inserir arquivo"
        app:layout_constraintTop_toBottomOf="@+id/btnDigitalizar" />

    <Button
        android:id="@+id/btnAcessar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginLeft="35dp"
        android:layout_marginRight="35dp"
        android:textSize="20dp"
        android:textColor="@color/white"
        app:backgroundTint="@null"
        android:background="@drawable/button_menu"
        android:text="Acessar documentos"
        app:layout_constraintTop_toBottomOf="@+id/btnInserir" />

    <!-- ... seus botões atuais ... -->

    <!-- 1. Fundo escuro do Tutorial -->
    <View
        android:id="@+id/viewDarken"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- 2. Texto explicativo do Tutorial -->
    <TextView
        android:id="@+id/txtTutorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:elevation="11dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40"/>

    <!-- 3. Camada invisível para interceptar os cliques (fica acima de tudo) -->
    <View
        android:id="@+id/viewClickInterceptor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="100dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>