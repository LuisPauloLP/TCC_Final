<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F4">

    <!-- Área principal -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="85dp">

        <!-- Visualização do documento -->
        <com.canhub.cropper.CropImageView
            android:id="@+id/cropImageView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="14dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnAnterior"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Confirmar ajuste -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarAjuste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="Confirmar ajuste"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:elevation="6dp"
            app:cornerRadius="12dp"
            app:backgroundTint="#218838"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Navegação entre páginas -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnterior"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="16dp"
            android:text="‹  Anterior"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#267A45"
            app:cornerRadius="12dp"
            app:strokeColor="#267A45"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnProximo"
            app:layout_constraintHorizontal_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProximo"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="Próximo  ›"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            app:backgroundTint="#267A45"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnAnterior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Painel inferior -->
    <LinearLayout
        android:id="@+id/bottomSheetGaveta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:elevation="16dp"
        app:behavior_peekHeight="45dp"
        app:behavior_hideable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Alça do painel -->
        <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:background="#D5DED8"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp"/>

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerenciar documento"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#253D2D"
            android:layout_marginBottom="14dp"/>

        <!-- Ajustar documento -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAjustar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Ajustar documento"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#267A45"
            android:layout_marginBottom="8dp"
            app:cornerRadius="12dp"
            app:strokeColor="#D5E5D9"
            app:strokeWidth="1dp"
            app:backgroundTint="#F5FAF6"
            app:icon="@android:drawable/ic_menu_crop"
            app:iconTint="#267A45"/>

        <!-- Adicionar página -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdicionar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Adicionar página"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#267A45"
            android:layout_marginBottom="8dp"
            app:cornerRadius="12dp"
            app:strokeColor="#D5E5D9"
            app:strokeWidth="1dp"
            app:backgroundTint="#F5FAF6"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="#267A45"/>

        <!-- Deletar documento -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Deletar documento"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#D32F2F"
            android:layout_marginBottom="12dp"
            app:cornerRadius="12dp"
            app:strokeColor="#F1D5D5"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFF7F7"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="#D32F2F"/>

        <!-- Mensagem de erro OCR -->
        <TextView
            android:id="@+id/txtErroOCR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="#FFF1F1"
            android:visibility="gone"
            android:layout_marginBottom="10dp"/>

        <!-- Campo do nome -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do arquivo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#45594A"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: Conta de energia"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#267A45"
            app:hintTextColor="#718477">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNomeArquivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="14sp"
                android:textColor="#253D2D"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Salvar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Salvar PDF"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:backgroundTint="#218838"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="#FFFFFF"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

