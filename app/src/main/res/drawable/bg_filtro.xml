<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECIONADO -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">

            <solid android:color="#2E7D32" />

            <corners android:radius="12dp" />

            <stroke
                android:width="2dp"
                android:color="#2E7D32" />

            <padding
                android:left="10dp"
                android:top="8dp"
                android:right="10dp"
                android:bottom="8dp" />

        </shape>
    </item>


    <!-- NÃO SELECIONADO -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <corners android:radius="12dp" />

            <stroke
                android:width="2dp"
                android:color="#2E7D32" />

            <padding
                android:left="10dp"
                android:top="8dp"
                android:right="10dp"
                android:bottom="8dp" />

        </shape>
    </item>

</selector>